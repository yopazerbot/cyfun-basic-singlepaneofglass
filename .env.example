# Copy to .env and fill in. Never commit .env.
# Server settings live here. Connector credentials and Claude are set on the Settings page in the
# application (stored encrypted with CYFUN_SECRET_KEY); the variables at the end override that page.

# ---------------------------------------------------------------- application
# Public URL users type in the browser. Must match the Entra redirect URI and the Caddy hostname.
APP_BASE_URL=https://cyfun.internal.example
APP_HOSTNAME=cyfun.internal.example
APP_NAME=CyFun
# Certificate source for Caddy: "internal" (own CA) or an e-mail address for Let's Encrypt.
CADDY_TLS=internal
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
# Encrypts the secrets entered on the Settings page. Random, at least 32 characters, generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep a copy in the password manager: a restore needs the same key. Changing it means re-entering the secrets.
CYFUN_SECRET_KEY=
# Internal Docker network between Caddy and the app; proxy headers are trusted only from it.
# Change it only if it overlaps a network you already use.
CYFUN_SUBNET=172.31.250.0/24

# ---------------------------------------------------------------- sign-in
# Local username/password accounts (default on). At first start the account admin / admin is
# created and must set a new password at first login. Set to false once Entra ID works.
AUTH_LOCAL_ENABLED=true
# Optional: first admin password instead of "admin" (for example a generated value); the first login still forces a change.
AUTH_BOOTSTRAP_PASSWORD=
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Microsoft Entra ID single sign-on. App registration: Web platform, redirect URI = APP_BASE_URL + /auth/callback,
# ID tokens enabled, app roles "Admin" and "Auditor", user assignment required. See docs/entra-id-sso.md.
# Leave the three values empty to run without Entra ID.
AUTH_TENANT_ID=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Role for Entra users without an app role: leave empty to deny them (recommended).
AUTH_DEFAULT_ROLE=
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=12

# ---------------------------------------------------------------- optional overrides of the Settings page
# Leave these empty and use the Settings page instead. A non-empty value wins and the field is read-only there.

# Hours between automatic connector runs (Settings page default: 24).
CONNECTOR_SYNC_HOURS=

# Microsoft Graph, separate app registration with application permissions (docs/connectors.md).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# GitHub fine-grained or classic token with read access. GITHUB_ORG empty = user mode.
GITHUB_TOKEN=
GITHUB_ORG=

# Railway account or team token (read).
RAILWAY_TOKEN=

# Cloudflare API token (Zone Read, DNS Read, Zone Settings Read, Zone WAF Read; account-level items
# need Access Read, Gateway Read, Logs Read, Audit Logs Read and CLOUDFLARE_ACCOUNT_ID).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Claude (Anthropic API), docs/ai-assistance.md.
ANTHROPIC_API_KEY=
# claude-opus-5-5 or claude-sonnet-5-5
AI_MODEL=
# low, medium or high
AI_EFFORT=
AI_MONTHLY_CAP_USD=
AI_REVIEW_AFTER_SYNC=
