# Copy to .env and fill in. Never commit .env. Every secret lives here and nowhere else.

# ---------------------------------------------------------------- application
# Public URL users type in the browser. Must match the Entra redirect URI and the Caddy hostname.
APP_BASE_URL=https://cyfun.internal.example
APP_HOSTNAME=cyfun.internal.example
APP_NAME=CyFun Basic
# Certificate source for Caddy: "internal" (own CA) or an e-mail address for Let's Encrypt.
CADDY_TLS=internal
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
# Hours between automatic connector runs.
CONNECTOR_SYNC_HOURS=24

# ---------------------------------------------------------------- Microsoft Entra ID single sign-on
# App registration: Web platform, redirect URI = APP_BASE_URL + /auth/callback, ID tokens enabled,
# app roles "Admin" and "Auditor", user assignment required. See docs/entra-id-sso.md.
AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
AUTH_CLIENT_SECRET=
# Role for authenticated users without an app role: leave empty to deny them (recommended).
AUTH_DEFAULT_ROLE=
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=12

# ---------------------------------------------------------------- connectors (optional, read-only credentials)
# Microsoft Graph, separate app registration with application permissions (docs/connectors.md).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# GitHub fine-grained or classic token with read access. GITHUB_ORG empty = user mode.
GITHUB_TOKEN=
GITHUB_ORG=

# Railway account or team token (read).
RAILWAY_TOKEN=

# Cloudflare API token (Zone Read, DNS Read, Zone Settings Read, Zone WAF Read; account-level items
# need Access Read, Gateway Read, Logs Read, Audit Logs Read and CLOUDFLARE_ACCOUNT_ID).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
